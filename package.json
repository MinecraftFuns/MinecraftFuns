{
  "name": "minecraftfuns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source for the GitHub profile README shown at github.com/MinecraftFuns",
  "homepage": "https://joefang.org",
  "bugs": {
    "url": "https://github.com/MinecraftFuns/MinecraftFuns/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinecraftFuns/MinecraftFuns.git"
  },
  "author": {
    "name": "Joe Fang",
    "url": "https://joefang.org"
  },
  "scripts": {
    "lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.github/skills\" \"#.claude/skills\"",
    "lint:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#.github/skills\" \"#.claude/skills\"",
    "typecheck": "astro check",
    "test:unit": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "check:dist": "node scripts/check-dist.mjs",
    "audit": "node scripts/audit/run.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm test && npm run build && npm run check:dist",
    "submodules": "git submodule update --init --recursive",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^26.1.2",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.6"
  }
}
