{
  "name": "minecraftfuns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source for the GitHub profile README shown at github.com/MinecraftFuns",
  "homepage": "https://joefang.org",
  "bugs": {
    "url": "https://github.com/MinecraftFuns/MinecraftFuns/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinecraftFuns/MinecraftFuns.git"
  },
  "author": {
    "name": "Joe Fang",
    "url": "https://joefang.org"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:changed": "node scripts/format-changed.ts",
    "format:check": "prettier --check .",
    "types:src": "astro check --minimumFailingSeverity hint",
    "types:scripts": "tsc -p tsconfig.scripts.json",
    "rules:classes": "node scripts/check-classes.ts",
    "rules:control-flow": "node scripts/check-control-flow.ts",
    "rules:typography": "node scripts/check-typography.ts",
    "rules:readme": "node scripts/check-readme.ts",
    "rules:autospace": "node scripts/check-autospace.ts",
    "rules:directives": "node scripts/check-directives.ts",
    "rules:vocabulary": "node scripts/check-vocabulary.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "build": "astro build",
    "dist:check": "node scripts/check-dist.ts",
    "audit": "node scripts/audit/run.ts",
    "types": "npm run types:src && npm run types:scripts",
    "rules": "npm run rules:classes && npm run rules:control-flow && npm run rules:typography && npm run rules:autospace && npm run rules:directives && npm run rules:vocabulary && npm run rules:readme",
    "check": "npm run format:check && npm run types && npm run rules && npm test",
    "verify": "npm run check && npm run build && npm run dist:check",
    "dev": "astro dev",
    "preview": "astro preview",
    "submodules": "git submodule update --init --recursive",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^26.1.2",
    "openpgp": "^6.3.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "katex": "^0.18.4",
    "tailwindcss": "^4.3.3"
  }
}
