---
import PageIntro from "../components/PageIntro.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Section from "../components/Section.astro";
import { site } from "../config/site.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectSections } from "../lib/projects.ts";

const sections = projectSections();
---

<BaseLayout
  title="Projects"
  description={`Side projects, research artifacts, and open-source contributions by ${site.name}.`}
>
  <PageIntro
    kind="page"
    eyebrow="Projects"
    title="Things I have built, studied, and contributed to."
    lede="Grouped by kind: things I built for myself, code that came out of research work, and patches to other people's projects."
  />

  {
    sections.map((section) => (
      <Section
        id={`${section.kind}-heading`}
        title={section.heading}
        blurb={section.blurb}
        trailing={{ tag: "count", value: section.items.length }}
      >
        <ul class="grid grid-cols-cards gap-md" role="list">
          {section.items.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </Section>
    ))
  }
</BaseLayout>
