---
import PageIntro from "../components/PageIntro.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Section from "../components/Section.astro";
import { projectsPage } from "../config/projects.ts";
import { site } from "../config/site.ts";
import { affixed } from "../lib/identity.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectSections } from "../lib/projects.ts";

const sections = projectSections();
---

<BaseLayout title="Projects" description={affixed(projectsPage.description, site.name)}>
  <PageIntro
    kind="page"
    eyebrow="Projects"
    title={projectsPage.copy.title}
    lede={projectsPage.copy.lede}
  />

  {
    sections.map((section) => (
      <Section
        id={`${section.kind}-heading`}
        title={section.heading}
        blurb={section.blurb}
        trailing={{ tag: "count", value: section.items.length }}
      >
        <ul class="grid grid-cols-cards gap-md" role="list">
          {section.items.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </Section>
    ))
  }
</BaseLayout>
