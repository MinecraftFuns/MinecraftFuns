---
import Button from "../components/Button.astro";
import Epigraph from "../components/Epigraph.astro";
import PageIntro from "../components/PageIntro.astro";
import PostRow from "../components/PostRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Section from "../components/Section.astro";
import { standing } from "../config/about.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { majorsPhrase } from "../lib/identity.ts";
import { postSummaries } from "../lib/posts.ts";
import { featuredProjects } from "../lib/projects.ts";
import { routeUrl } from "../lib/url.ts";

// Three most recent posts; blog index holds rest.
const recentPosts = await postSummaries(3);
const selected = featuredProjects();
---

<BaseLayout>
  {/* Opens on the person; the work is one scroll away. */}
  <PageIntro
    kind="hero"
    eyebrow="Toronto"
    title="I like knowing how things work underneath."
    lede={`${majorsPhrase} at the ${standing.institution}: the same curiosity pointed at machines and at minds. I build private networks, self-hosted services, and privacy tooling. The blog is for findings, know-how, and the occasional rant.`}
  >
    <div class="flex flex-wrap gap-xs">
      <Button href={routeUrl("/blog")} tone="primary" size="control">Read the blog</Button
      >
      <Button href={routeUrl("/about")} tone="secondary" size="control"
        >How to reach me</Button
      >
    </div>
  </PageIntro>

  <Epigraph
    quote="Freedom is the freedom to say that two plus two make four. If that is granted, all else follows."
    author="George Orwell"
    source={{
      href: "https://en.wikipedia.org/wiki/Nineteen_Eighty-Four",
      label: "Nineteen Eighty-Four",
    }}
  />

  <Section
    id="work-heading"
    title="Selected projects"
    trailing={{ tag: "link", href: routeUrl("/projects"), label: "All projects" }}
  >
    <ul class="grid grid-cols-cards gap-md" role="list">
      {
        selected.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    id="writing-heading"
    title="Recent posts"
    trailing={{ tag: "link", href: routeUrl("/blog"), label: "All posts" }}
  >
    <div class="*:last:border-b-0">
      {recentPosts.map((post) => <PostRow post={post} />)}
    </div>
  </Section>
</BaseLayout>
