---
import PostRow from "../components/PostRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact, projects } from "../config.ts";
import { postSummaries } from "../lib/posts.ts";
import { withBase } from "../lib/url.ts";

// The three most recent posts; the blog index holds the rest.
const recentPosts = await postSummaries(3);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Toronto, Canada</p>
    <h1 class="hero__title">
      Joe Fang builds software and studies how minds work.
    </h1>
    <p class="page-intro__lede">
      Third-year undergraduate at the University of Toronto, double majoring in
      Computer Science and Cognitive Science with a minor in Statistics.
    </p>
    <div class="hero__actions">
      <a class="button button--primary" href={withBase("/projects")}>View projects</a>
      <a class="button button--secondary" href={contact.pgp}>Get in touch</a>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="section__head">
      <h2 class="section__title" id="work-heading">Selected projects</h2>
      <a class="section__link" href={withBase("/projects")}>All projects</a>
    </div>
    <ul class="grid" role="list">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="writing-heading">
    <div class="section__head">
      <h2 class="section__title" id="writing-heading">Recent posts</h2>
      <a class="section__link" href={withBase("/blog")}>All posts</a>
    </div>
    <div class="rows">
      {recentPosts.map((post) => <PostRow post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* The home page differs from the other intros in exactly one way — it opens
     at display-lg and with section spacing above — so it keeps its own rule
     rather than parameterising the shared one. */
  .hero {
    padding-block: var(--space-section) var(--space-lg);
  }

  .hero__title {
    margin-top: var(--space-xs);
    font-size: var(--text-display-lg);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }
</style>
