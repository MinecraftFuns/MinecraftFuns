---
import Button from "../components/Button.astro";
import Epigraph from "../components/Epigraph.astro";
import PageIntro from "../components/PageIntro.astro";
import PostRow from "../components/PostRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../config/projects.ts";
import { pgpHref } from "../lib/contact.ts";
import { postSummaries } from "../lib/posts.ts";
import { routeUrl } from "../lib/url.ts";

// The three most recent posts; the blog index holds the rest.
const recentPosts = await postSummaries(3);
---

<BaseLayout>
  {/* Opens on a question, not a résumé; the credential is one click away. */}
  <PageIntro
    kind="hero"
    eyebrow="Toronto"
    title="A compiler and a mind are both machines for turning symbols into meaning."
    lede="I study both at the University of Toronto, and I write here about where the analogy leaks: types, time zones, private networks, and the small bugs that turn out to have been category errors all along."
  >
    <div class="flex flex-wrap gap-xs">
      <Button href={routeUrl("/blog")} tone="primary" size="control">Read the blog</Button>
      <Button href={pgpHref()} tone="secondary" size="control">Get in touch</Button>
    </div>
  </PageIntro>

  <Epigraph
    quote="Freedom is the freedom to say that two plus two make four. If that is granted, all else follows."
    author="George Orwell"
    source={{ href: "https://en.wikipedia.org/wiki/Nineteen_Eighty-Four", label: "Nineteen Eighty-Four" }}
  />

  <Section
    id="work-heading"
    title="Selected projects"
    trailing={{ kind: "link", href: routeUrl("/projects"), label: "All projects" }}
  >
    <ul class="grid grid-cols-cards gap-md" role="list">
      {projects.map((project) => <li><ProjectCard project={project} /></li>)}
    </ul>
  </Section>

  <Section
    id="writing-heading"
    title="Recent posts"
    trailing={{ kind: "link", href: routeUrl("/blog"), label: "All posts" }}
  >
    <div class="*:last:border-b-0">
      {recentPosts.map((post) => <PostRow post={post} />)}
    </div>
  </Section>
</BaseLayout>
