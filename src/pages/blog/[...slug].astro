---
import { render } from "astro:content";

import ArticleHeader from "../../components/ArticleHeader.astro";
import ArticlePage from "../../layouts/ArticlePage.astro";
import { routeOf } from "../../lib/archive.ts";
import { publishedPosts, summarise, type PublishedPost } from "../../lib/posts.ts";
import { routeUrl } from "../../lib/url.ts";

/*
 * Routes are generated only from published posts, so a draft has no URL at all
 * rather than an unlisted one that anybody could guess.
 *
 * The parameter comes from the reconciled path rather than the raw entry id,
 * so the route a page is built at and the href every index links to are two
 * uses of one value instead of two constructions that could differ.
 */
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({
    params: { slug: routeOf(post.path) },
    props: { post },
  }));
}

type Props = { readonly post: PublishedPost };

const { post } = Astro.props;
const { entry } = post;
const { Content } = await render(entry);

/* Through `summarise` so the article header and the index row cannot report
   different reading times, or differently typed tags, for the same post. */
const { readingMinutes: minutes, tags } = summarise(post);
---

<ArticlePage
  title={entry.data.title}
  description={entry.data.description}
  back={{ href: routeUrl("/blog"), label: "All posts" }}
>
  <ArticleHeader
    slot="header"
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.date}
    readingMinutes={minutes}
    tags={tags}
  />

  <Content />
</ArticlePage>
