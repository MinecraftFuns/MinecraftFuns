---
import { render } from "astro:content";

import ArticleHeader from "../../components/ArticleHeader.astro";
import TranslationNote from "../../components/TranslationNote.astro";
import ArticlePage from "../../layouts/ArticlePage.astro";
import { langRouteOf, routeOf } from "../../lib/archive.ts";
import {
  alternatesOf,
  canonicalPathOf,
  originalOf,
  othersOf,
  primary,
} from "../../lib/article.ts";
import { bcp47Of, nativeNameOf, SITE_LANG } from "../../lib/lang.ts";
import {
  minutesOf,
  publishedArticles,
  type PublishedArticle,
  type PublishedRendition,
} from "../../lib/posts.ts";
import { routeUrl } from "../../lib/url.ts";

/*
 * Routes are generated only from published renditions, so a draft has no URL
 * at all rather than an unlisted one that anybody could guess.
 *
 * Every article is served at its bare route, which renders the primary
 * rendition: the article's best language by the preference order in
 * `config/languages.ts`. Every rendition in any *other* language is
 * additionally served at its language-suffixed route, primary or not, so
 * `/blog/YYYY/MM/slug/zh/` holds from the day a Chinese rendition exists and
 * a better-preferred translation arriving later changes what the bare URL
 * renders, never where the Chinese lives. `canonicalPathOf` says which of a
 * rendition's addresses is the one to index.
 *
 * The parameters come from the reconciled path rather than the raw entry id,
 * so the route a page is built at and the href every index links to are two
 * uses of one value instead of two constructions that could differ.
 */
export async function getStaticPaths() {
  const articles = await publishedArticles();

  return articles.flatMap((article) => {
    const bare = {
      params: { slug: routeOf(article.path) },
      props: { article, rendition: primary(article) },
    };

    const suffixed = article.renditions
      .filter((rendition) => rendition.lang !== SITE_LANG)
      .map((rendition) => ({
        params: { slug: langRouteOf(article.path, rendition.lang) },
        props: { article, rendition },
      }));

    return [bare, ...suffixed];
  });
}

type Props = {
  readonly article: PublishedArticle;
  readonly rendition: PublishedRendition;
};

const { article, rendition } = Astro.props;
const { entry } = rendition;
const { Content } = await render(entry);

/* Through `minutesOf` so the article header and the index row cannot report
   different reading times for the same body. */
const minutes = minutesOf(entry);

const crossLink = (target: PublishedRendition) => ({
  href: routeUrl(canonicalPathOf(article, target.lang)),
  hrefLang: bcp47Of(target.lang),
  label: nativeNameOf(target.lang),
});

/* Every other rendition, preference-ordered: the reader's ways across. */
const alternates = othersOf(article, rendition.lang).map(crossLink);

/*
 * The rendition the translations were made from. Guaranteed to exist by
 * `assemble` (an article of translations with no original fails the build),
 * so the guard below is for the checker, which cannot see that far.
 */
const original = originalOf(article);
---

<ArticlePage
  title={entry.data.title}
  description={entry.data.description}
  lang={bcp47Of(rendition.lang)}
  canonicalRoute={canonicalPathOf(article, rendition.lang)}
  alternates={alternatesOf(article)}
  back={{ href: routeUrl("/blog"), label: "All posts" }}
>
  <Fragment slot="header">
    <ArticleHeader
      title={entry.data.title}
      description={entry.data.description}
      date={article.date}
      lang={rendition.lang}
      readingMinutes={minutes}
      tags={article.tags}
      alternates={alternates}
    />
    {
      rendition.provenance.tag === "translation" && original !== undefined && (
        <TranslationNote
          lang={rendition.lang}
          by={rendition.provenance.by}
          original={{
            lang: original.lang,
            href: routeUrl(canonicalPathOf(article, original.lang)),
          }}
        />
      )
    }
  </Fragment>

  <Content />
</ArticlePage>
