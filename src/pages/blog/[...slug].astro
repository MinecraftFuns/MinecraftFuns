---
import { render, type CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedPosts, summarise } from "../../lib/posts.ts";
import { formatIsoDate } from "../../lib/time.ts";
import { withBase } from "../../lib/url.ts";

/*
 * Routes are generated only from published posts, so a draft has no URL at all
 * rather than an unlisted one that anybody could guess.
 */
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { readonly post: CollectionEntry<"blog"> };

const { post } = Astro.props;
const { Content } = await render(post);

/* Through `summarise` so the article header and the index row cannot report
   different reading times for the same post. */
const { readingMinutes: minutes } = summarise(post);
const published = formatIsoDate(post.data.date);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <article class="pt-xl pb-lg">
    <header class="border-hairline mb-lg border-b pb-lg">
      <p class="text-ink-tertiary flex items-center gap-2xs font-mono text-caption">
        <time datetime={post.data.date}>{published}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="text-display-md text-ink mt-xs">{post.data.title}</h1>
      <p class="text-body-lg text-ink-muted mt-sm max-w-measure">
        {post.data.description}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-md flex flex-wrap gap-2xs" role="list">
            {post.data.tags.map((tag) => (
              <li class="border-hairline bg-surface-1 text-ink-subtle rounded-pill border px-2xs py-3xs text-caption">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="border-hairline mt-xl border-t pt-md text-body-sm">
      <a class="text-accent hover:text-accent-hover" href={withBase("/blog")}>
        ← All posts
      </a>
    </footer>
  </article>
</BaseLayout>
