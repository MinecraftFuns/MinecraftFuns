---
import { render, type CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedPosts } from "../../lib/posts.ts";
import { readingMinutes } from "../../lib/reading.ts";
import { formatIsoDate } from "../../lib/time.ts";
import { withBase } from "../../lib/url.ts";

/*
 * Routes are generated only from published posts, so a draft has no URL at all
 * rather than an unlisted one that anybody could guess.
 */
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { readonly post: CollectionEntry<"blog"> };

const { post } = Astro.props;
const { Content } = await render(post);

const published = formatIsoDate(post.data.date);
const minutes = readingMinutes(post.body ?? "");
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <article class="post container container--narrow">
    <header class="post__header">
      <p class="post__meta">
        <time datetime={post.data.date}>{published}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="post__title">{post.data.title}</h1>
      <p class="post__description">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <ul class="tags" role="list">
            {post.data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post__footer">
      <a href={withBase("/blog")}>← All posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-xl) var(--space-lg);
  }

  .post__header {
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--hairline);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ink-tertiary);
  }

  .post__title {
    margin-top: var(--space-xs);
    font-size: var(--text-display-md);
    font-weight: var(--weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display-md);
  }

  .post__description {
    margin-top: var(--space-sm);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
    color: var(--ink-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-md) 0 0;
  }

  .tag {
    padding: 2px var(--space-2xs);
    background-color: var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    font-size: var(--text-caption);
    color: var(--ink-subtle);
  }

  .post__footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--hairline);
    font-size: var(--text-body-sm);
  }
</style>
