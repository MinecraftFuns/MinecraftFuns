---
import TagStrip from "../../components/TagStrip.astro";
import ListPage from "../../layouts/ListPage.astro";
import PagedListPage from "../../layouts/PagedListPage.astro";
import { firstPage } from "../../lib/paging.ts";
import { BLOG_DESCRIPTION, BLOG_INTRO } from "../../lib/listings.ts";
import { BLOG_BASE, postPages, tagBrowse } from "../../lib/posts.ts";

/** Blog base route owns page one; later pages use `/page/[page].astro`. */
const page = firstPage(await postPages());
const strip = await tagBrowse();
---

{
  page === undefined ? (
    <ListPage {...BLOG_INTRO} title="Blog" description={BLOG_DESCRIPTION} />
  ) : (
    <PagedListPage
      {...BLOG_INTRO}
      title="Blog"
      description={BLOG_DESCRIPTION}
      base={BLOG_BASE}
      page={page}
    >
      {strip !== undefined && <TagStrip strip={strip} slot="browse" />}
    </PagedListPage>
  )
}
