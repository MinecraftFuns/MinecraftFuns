---
import PageIntro from "../../components/PageIntro.astro";
import PostRow from "../../components/PostRow.astro";
import PostTags from "../../components/PostTags.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { postSummaries, postTags } from "../../lib/posts.ts";

const posts = await postSummaries();

/* `PostTags` again rather than a browse-specific component: these are the same
   links a post renders, and one list of the blog's tags is the point. Both
   come from the same collection, so no tag here is missing from the posts
   below. */
const tags = (await postTags()).map((taxon) => taxon.label);
---

<BaseLayout
  title="Blog"
  description="Technical notes on software, systems, and cognitive science by Joe Fang."
>
  <PageIntro
    kind="page"
    eyebrow="Blog"
    title="Technical notes, written down so I stop re-deriving them."
    lede="Mostly software and systems, occasionally cognitive science. Written for the version of me who hits the same problem in a year."
  />

  <PostTags tags={tags} />

  <section aria-label="All posts">
    {
      posts.length === 0 ? (
        <p class="text-ink-subtle py-lg">No posts published yet.</p>
      ) : (
        /* This list has no section head above it, so it supplies the rule that
           a head would otherwise draw. */
        <div class="border-hairline border-t *:last:border-b-0">
          {posts.map((post) => (
            <PostRow post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
