---
import PagedListPage from "../../../../layouts/PagedListPage.astro";
import { firstPage, type Page } from "../../../../lib/paging.ts";
import { postTags, type PostSummary } from "../../../../lib/posts.ts";
import { tagListing, type TagListing } from "../../../../lib/tag-listing.ts";
import { routeUrl } from "../../../../lib/url.ts";

/** Generate the taxonomy-backed first page for each tag. */
export async function getStaticPaths() {
  const tags = await postTags();

  return tags.map((taxon) => {
    const listing = tagListing(taxon);
    return {
      params: { tag: taxon.slug },
      /* Non-empty taxa always have a first page. */
      props: { listing, page: firstPage(listing.pages) },
    };
  });
}

type Props = {
  readonly listing: TagListing;
  readonly page: Page<PostSummary> | undefined;
};

const { listing, page } = Astro.props;
---

{
  page !== undefined && (
    <PagedListPage
      {...listing.intro}
      title={listing.title}
      description={listing.description}
      base={listing.base}
      page={page}
      back={{ href: routeUrl("/blog"), label: "All posts" }}
    />
  )
}
