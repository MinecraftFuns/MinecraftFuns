---
import PostRow from "../../../components/PostRow.astro";
import ListPage from "../../../layouts/ListPage.astro";
import type { NonEmpty } from "../../../prelude/adt.ts";
import { postTags, type PostSummary, type PostTag } from "../../../lib/posts.ts";
import { routeUrl } from "../../../lib/url.ts";

/*
 * One page per tag, built from the same taxonomy the tag links are derived
 * from, so a link can only point at a page that exists. `taxonomy` rejects a
 * tag with no usable URL segment, and two tags that would share one, before
 * any of this runs.
 */
export async function getStaticPaths() {
  const tags = await postTags();
  return tags.map((taxon) => ({
    params: { tag: taxon.slug },
    props: { tag: taxon.label, posts: taxon.items },
  }));
}

type Props = {
  readonly tag: PostTag;
  /* Non-empty by type: a tag exists only by being on a post, so the empty
     state `ListPage` can render is unreachable from here. */
  readonly posts: NonEmpty<PostSummary>;
};

const { tag, posts } = Astro.props;

const count = `${posts.length} post${posts.length === 1 ? "" : "s"}`;
---

<ListPage
  title={`Posts tagged ${tag}`}
  description={`Writing tagged ${tag}, newest first.`}
  eyebrow="Tag"
  heading={tag}
  lede={`${count} tagged ${tag}, newest first.`}
  label={`Posts tagged ${tag}`}
  empty="No posts published yet."
  back={{ href: routeUrl("/blog"), label: "All posts" }}
>
  {posts.map((post) => <PostRow post={post} />)}
</ListPage>
