---
import TagChips from "../../../components/TagChips.astro";
import ListPage from "../../../layouts/ListPage.astro";
import { postTags } from "../../../lib/posts.ts";
import { routeUrl } from "../../../lib/url.ts";

/**
 * The tag directory: every tag, alphabetically, each with its post count.
 *
 * A guessable URL that answered with a 404 until now, and the destination the
 * blog's browse strip sends readers to once it stops showing every tag.
 * Alphabetical rather than ranked, because this is the page you arrive at
 * looking for a tag you already have in mind; the strip is the ranked view.
 */
const tags = await postTags();

const total = `${tags.length} tag${tags.length === 1 ? "" : "s"}`;
---

<ListPage
  title="Tags"
  description="Every tag on the blog, with the number of posts behind each."
  eyebrow="Blog"
  heading="Tags"
  lede={`${total} across the archive, alphabetically, with the number of posts behind each.`}
  label="All tags"
  empty="No tags yet."
  back={{ href: routeUrl("/blog"), label: "All posts" }}
>
  <TagChips tags={tags} />
</ListPage>
