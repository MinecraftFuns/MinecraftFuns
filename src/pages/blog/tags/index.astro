---
import ChipList from "../../../components/ChipList.astro";
import ListPage from "../../../layouts/ListPage.astro";
import { postTags, tagHref } from "../../../lib/posts.ts";
import { countedNoun } from "../../../lib/plural.ts";
import { routeUrl } from "../../../lib/url.ts";

/** Alphabetical tag directory; the strip shows the ranked subset. */
const tags = await postTags();

const total = countedNoun(tags.length, "tag");

const chips = tags.map((taxon) => ({
  label: taxon.label,
  href: tagHref(taxon.label),
  count: taxon.items.length,
}));
---

<ListPage
  title="Tags"
  description="Every tag on the blog, with the number of posts behind each."
  eyebrow="Blog"
  heading="Tags"
  lede={`${total} across the archive, alphabetically.`}
  label="All tags"
  empty="No tags yet."
  back={{ href: routeUrl("/blog"), label: "All posts" }}
>
  <ChipList chips={chips} />
</ListPage>
