---
import DocCategories from "../../components/DocCategories.astro";
import DocRow from "../../components/DocRow.astro";
import ListPage from "../../layouts/ListPage.astro";
import { docCategories, docSummaries } from "../../lib/docs.ts";

const docs = await docSummaries();

/* Both come from the same collection, so the browse list cannot offer a
   category that no doc below is filed under. */
const categories = (await docCategories()).map((taxon) => taxon.label);
---

<ListPage
  title="Docs"
  description="Reference and troubleshooting guides by Joe Fang."
  chrome="document"
  eyebrow="Docs"
  heading="Guides worth writing down once."
  lede="Reference pages and troubleshooting notes. Read when something breaks, rather than in the order they were written."
  label="All docs"
  empty="No docs published yet."
>
  <DocCategories slot="browse" categories={categories} />
  {docs.map((doc) => <DocRow doc={doc} />)}
</ListPage>
