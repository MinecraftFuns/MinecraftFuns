---
import DocCategories from "../../components/DocCategories.astro";
import DocRow from "../../components/DocRow.astro";
import ListPage from "../../layouts/ListPage.astro";
import { docsPage } from "../../config/docs.ts";
import { site } from "../../config/site.ts";
import { docCategories, docSummaries } from "../../lib/docs.ts";
import { affixed } from "../../lib/identity.ts";

const rows = await docSummaries();

/* One collection supplies categories and rows, preventing orphaned links. */
const categories = (await docCategories()).map((taxon) => taxon.label);
---

<ListPage
  {...docsPage.intro}
  title="Docs"
  description={affixed(docsPage.description, site.name)}
  chrome="document"
>
  <DocCategories slot="browse" categories={categories} />
  {rows.map((doc) => <DocRow doc={doc} />)}
</ListPage>
