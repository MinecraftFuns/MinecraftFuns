---
import DocRow from "../../../components/DocRow.astro";
import ListPage from "../../../layouts/ListPage.astro";
import type { NonEmpty } from "../../../prelude/adt.ts";
import { docCategories, type DocCategory, type DocSummary } from "../../../lib/docs.ts";
import { countedNoun } from "../../../lib/plural.ts";
import { routeUrl } from "../../../lib/url.ts";

/* Taxonomy-derived page; every category link points to an existing page. */
export async function getStaticPaths() {
  const categories = await docCategories();
  return categories.map((taxon) => ({
    params: { category: taxon.slug },
    props: { category: taxon.label, docs: taxon.items },
  }));
}

type Props = {
  readonly category: DocCategory;
  /* NonEmpty because every category belongs to a doc. */
  readonly docs: NonEmpty<DocSummary>;
};

const { category, docs } = Astro.props;

const count = countedNoun(docs.length, "guide");
---

<ListPage
  title={`${category} docs`}
  description={`Reference and troubleshooting guides filed under ${category}.`}
  chrome="document"
  eyebrow="Category"
  heading={category}
  lede={`${count} filed under ${category}.`}
  label={`Docs in ${category}`}
  empty="No docs published yet."
  back={{ href: routeUrl("/docs"), label: "All docs" }}
>
  {docs.map((doc) => <DocRow doc={doc} />)}
</ListPage>
