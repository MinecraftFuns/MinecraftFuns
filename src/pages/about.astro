---
import EntryList, { type Entry } from "../components/EntryList.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import { education } from "../config/about.ts";
import { pgpHref, profiles, siteFingerprint } from "../lib/contact.ts";
import { routeUrl } from "../lib/url.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

/*
 * This page absorbs what was previously split across "CV" and "About". The two
 * overlapped almost entirely: a CV is a structured view of the same facts a
 * bio states in prose. One page, prose first, structured sections beneath.
 *
 * Only verifiable facts appear below. Sections for experience, skills, and
 * awards are left as commented templates at the foot of this file rather than
 * filled with plausible-looking placeholder text: an invented internship that
 * ships to a live CV is worse than a short one.
 */

/* Read off the key, so rotating it cannot leave a stale one printed here. */
const fingerprint = await siteFingerprint();

/*
 * Both lists below are data. `EntryList` owns the grid, the label column, and
 * the type of every value shape, so this page states facts and nothing about
 * how they look.
 */
const educationEntries: readonly Entry[] = education.map((entry) => ({
  label: entry.period,
  body: {
    kind: "lines",
    title: entry.institution,
    /* `detail` is optional, so an absent one contributes no line at all
       rather than an empty paragraph holding space. */
    notes: [entry.credential, entry.detail].filter((note) => note !== undefined),
  },
}));

const contactEntries: readonly Entry[] = [
  { label: "PGP", body: { kind: "mono", value: fingerprint } },
  ...profiles.map((item): Entry => ({
    label: item.label,
    body: { kind: "link", href: item.href, label: item.handle },
  })),
];
---

<BaseLayout
  title="About"
  description="Joe Fang. Computer Science and Cognitive Science at the University of Toronto."
>
  <PageIntro kind="page" eyebrow="About" title="Joe Fang">
    <div class="prose">
      <p>
        I am a fourth-year undergraduate at the University of Toronto, taking a double
        major in Computer Science and Cognitive Science alongside a minor in Statistics.
        The combination is deliberate: I am interested in how systems represent and
        process information, whether the system happens to be a compiler or a mind.
      </p>
      <p>
        This site holds my <a href={routeUrl("/projects")}>projects</a> and a <a
          href={routeUrl("/blog")}>blog</a
        > of technical notes.
      </p>
    </div>
  </PageIntro>

  <Section id="education" title="Education">
    <EntryList entries={educationEntries} />
  </Section>

  <Section id="contact" title="Contact">
    <div class="prose mb-md">
      <p>
        For anything substantive, import my <a href={pgpHref()}>PGP key</a> and write to the
        address in its <strong>Primary User ID</strong>. There is deliberately no
        plaintext address on this page.
      </p>
    </div>
    <EntryList entries={contactEntries} />
  </Section>

  {
    /*
    Template for the remaining CV sections. Uncomment and fill; the shape is
    the same data an education entry is built from.

    <Section id="experience" title="Experience">
      <EntryList
        entries={[
          {
            label: "2026",
            body: {
              kind: "lines",
              title: "Role, Organisation",
              notes: ["One line on what you did."],
            },
          },
        ]}
      />
    </Section>
  */
  }
</BaseLayout>
