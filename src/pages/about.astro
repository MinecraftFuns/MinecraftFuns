---
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import { contact } from "../config.ts";
import { withBase } from "../lib/url.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

/*
 * This page absorbs what was previously split across "CV" and "About". The two
 * overlapped almost entirely: a CV is a structured view of the same facts a
 * bio states in prose. One page, prose first, structured sections beneath.
 *
 * Only verifiable facts appear below. Sections for experience, skills, and
 * awards are left as commented templates at the foot of this file rather than
 * filled with plausible-looking placeholder text — an invented internship that
 * ships to a live CV is worse than a short one.
 */

const education = [
  {
    institution: "University of Toronto",
    credential: "Double major in Computer Science and Cognitive Science",
    detail: "Minor in Statistics",
    period: "Third year",
  },
];

const elsewhere = [
  { label: "GitHub", value: "MinecraftFuns", href: contact.github },
  { label: "Matrix", value: "@multiset:matrix.org", href: contact.matrix },
  { label: "Twitter", value: "@SerendipityArk", href: contact.twitter },
];

/* Period in a fixed left column, detail beside it — the standard CV rhythm,
   collapsing to stacked rows where the column would crowd the text. */
const ENTRY = "grid gap-md border-b border-hairline py-sm last:border-b-0 sm:grid-cols-entry";
const ENTRY_PERIOD = "text-ink-tertiary font-mono text-caption";
---

<BaseLayout
  title="About"
  description="Joe Fang — Computer Science and Cognitive Science at the University of Toronto."
>
  <PageIntro kind="page" eyebrow="About" title="Joe Fang">
    <div class="prose mt-md">
      <p>
        I am a third-year undergraduate at the University of Toronto, taking a
        double major in Computer Science and Cognitive Science alongside a minor
        in Statistics. The combination is deliberate: I am interested in how
        systems represent and process information, whether the system happens to
        be a compiler or a mind.
      </p>
      <p>
        This site holds my <a href={withBase("/projects")}>projects</a> and a
        <a href={withBase("/blog")}>blog</a> of technical notes.
      </p>
    </div>
  </PageIntro>

  <Section id="education" title="Education">
    <dl>
      {
        education.map((entry) => (
          <div class={ENTRY}>
            <dt class={ENTRY_PERIOD}>{entry.period}</dt>
            <dd>
              <p class="text-ink text-control">{entry.institution}</p>
              <p class="text-body-sm text-ink-subtle">{entry.credential}</p>
              <p class="text-body-sm text-ink-subtle">{entry.detail}</p>
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="contact" title="Contact">
    <div class="prose mb-md">
      <p>
        For anything substantive, import my <a href={contact.pgp}>PGP key</a> and
        write to the address in its <strong>Primary User ID</strong>. There is
        deliberately no plaintext address on this page.
      </p>
    </div>
    <dl>
      <div class={ENTRY}>
        <dt class={ENTRY_PERIOD}>PGP</dt>
        <dd class="text-ink-muted font-mono text-body-sm wrap-anywhere">
          {contact.pgpFingerprint}
        </dd>
      </div>
      {
        elsewhere.map((item) => (
          <div class={ENTRY}>
            <dt class={ENTRY_PERIOD}>{item.label}</dt>
            <dd>
              <a class="text-accent hover:text-accent-hover" href={item.href}>
                {item.value}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {/*
    Template for the remaining CV sections. Uncomment and fill; ENTRY and
    ENTRY_PERIOD above already cover the layout.

    <Section id="experience" title="Experience">
      <dl>
        <div class={ENTRY}>
          <dt class={ENTRY_PERIOD}>2026</dt>
          <dd>
            <p class="text-ink text-control">Role, Organisation</p>
            <p class="text-body-sm text-ink-subtle">One line on what you did.</p>
          </dd>
        </div>
      </dl>
    </Section>
  */}
</BaseLayout>
