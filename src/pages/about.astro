---
import EntryList, { type Entry } from "../components/EntryList.astro";
import PageIntro from "../components/PageIntro.astro";
import Section from "../components/Section.astro";
import { site } from "../config/site.ts";
import { standing } from "../config/about.ts";
import { pgpHref, profiles, siteFingerprint } from "../lib/contact.ts";
import {
  aboutDescription,
  credentialClause,
  educationEntries as education,
  minorClause,
  standingPhrase,
} from "../lib/identity.ts";
import { routeUrl } from "../lib/url.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

/* One page replaces overlapping CV/About views; only verifiable facts render. */

/* Derive fingerprint from key source so rotation updates the page automatically. */
const fingerprint = await siteFingerprint();

/*
 * Both lists below are data. `EntryList` owns the grid, the label column, and
 * the type of every value shape, so this page states facts and nothing about
 * how they look.
 */
const educationEntries: readonly Entry[] = education.map((entry) => ({
  label: entry.period,
  body: {
    tag: "lines",
    title: entry.institution,
    /* Omit absent detail rather than rendering an empty paragraph. */
    notes: [entry.credential, entry.detail].filter((note) => note !== undefined),
  },
}));

const contactEntries: readonly Entry[] = [
  { label: "PGP", body: { tag: "mono", value: fingerprint } },
  ...profiles.map((item): Entry => ({
    label: item.label,
    body: { tag: "link", href: item.href, label: item.handle },
  })),
];
---

<BaseLayout title="About" description={aboutDescription}>
  <PageIntro kind="page" eyebrow="About" title={site.name}>
    <div class="prose">
      {
        /*
         * Identity text comes from one source to prevent drift.
         */
      }
      <p>
        I am a {standingPhrase} undergraduate at the {standing.institution}, taking a {
          credentialClause
        }{minorClause !== undefined && <> alongside a {minorClause}</>}. The second major
        is there because the question I find interesting sits in both: what a system has
        to represent, and what it can get away with not representing.
      </p>
      <p>
        This site holds my <a href={routeUrl("/projects")}>projects</a> and a <a
          href={routeUrl("/blog")}>blog</a
        > of mostly technical notes.
      </p>
    </div>
  </PageIntro>

  <Section id="education" title="Education">
    <EntryList entries={educationEntries} />
  </Section>

  <Section id="contact" title="Contact">
    <div class="prose mb-md">
      <p>
        For anything substantive, import my <a href={pgpHref()}>PGP key</a> and write to the
        address in its <strong>Primary User ID</strong>. The address is not written out
        here in plain text, which keeps it out of scrapers.
      </p>
    </div>
    <EntryList entries={contactEntries} />
  </Section>

  {
    /* Template for future CV sections; uncomment and fill with verified data.

    <Section id="experience" title="Experience">
      <EntryList
        entries={[
          {
            label: "2026",
            body: {
              tag: "lines",
              title: "Role, Organisation",
              notes: ["One line on what you did."],
            },
          },
        ]}
      />
    </Section>
  */
  }
</BaseLayout>
