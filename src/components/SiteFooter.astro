---
import { site } from "../config/site.ts";
import { elsewhere, siteFingerprint } from "../lib/contact.ts";
import { currentYear } from "../lib/time.ts";

/* Build year at render time; redeploy updates it. */
const year = currentYear();

const fingerprint = await siteFingerprint();
---

<footer class="note border-hairline border-t py-xl">
  {
    /* Baseline-align the columns: the brand line and the eyebrows differ in size,
      so top alignment leaves their first lines on three different baselines. */
  }
  <div
    class="mx-auto grid w-full max-w-frame grid-cols-footer items-baseline gap-lg px-md md:px-lg"
  >
    <div class="flex flex-col gap-2xs">
      <p class="text-ink text-control">{site.name}</p>
      <p class="text-caption">
        {/* Inline links need more than color under WCAG 1.4.1. */}
        © {year} · Built with <a class="link" href="https://astro.build">Astro</a>
      </p>
    </div>

    <nav class="flex flex-col gap-2xs" aria-label="Elsewhere">
      <h2 class="eyebrow">Elsewhere</h2>
      <ul class="flex flex-col gap-3xs" role="list">
        {
          elsewhere().map((link) => (
            <li>
              {/* Standalone links need WCAG 2.5.8 target height. */}
              <a
                class="link-muted flex min-h-target w-fit items-center"
                href={link.href}
                rel={link.isIdentity ? "me" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col gap-2xs">
      <h2 class="eyebrow">PGP fingerprint</h2>
      <p class="font-mono text-caption max-w-fingerprint wrap-anywhere">
        {fingerprint}
      </p>
    </div>
  </div>
</footer>
