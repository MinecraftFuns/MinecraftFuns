---
import { site } from "../config/site.ts";
import { elsewhere, siteFingerprint } from "../lib/contact.ts";
import { currentYear } from "../lib/time.ts";

/*
 * Reading the clock is an effect, so it happens here at the render edge rather
 * than inside a module constant. It is evaluated once at build time; the year
 * advances on redeploy, not at midnight.
 */
const year = currentYear();

/* Derived from the key, not restated beside it. */
const fingerprint = await siteFingerprint();
---

<footer class="border-hairline text-ink-subtle mt-section border-t py-xl text-body-sm">
  <div
    class="mx-auto grid w-full max-w-frame grid-cols-footer gap-lg px-md md:px-lg"
  >
    <div class="flex flex-col gap-2xs">
      <p class="text-ink text-control">{site.name}</p>
      <p class="text-caption">
        © {year} · Built with <a class="text-accent hover:text-accent-hover" href="https://astro.build">Astro</a>
      </p>
    </div>

    <nav class="flex flex-col gap-2xs" aria-label="Elsewhere">
      <h2 class="text-eyebrow text-ink-subtle uppercase">Elsewhere</h2>
      <ul class="flex flex-col gap-3xs" role="list">
        {
          elsewhere().map((link) => (
            <li>
              {/*
                A column of links is not text flow, so WCAG 2.5.8's inline
                exception does not apply and the bare 21px line box was a real
                target-size failure.
              */}
              <a
                class="text-ink-subtle hover:text-ink flex min-h-target w-fit items-center no-underline hover:underline"
                href={link.href}
                rel={link.isIdentity ? "me" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col gap-2xs">
      <h2 class="text-eyebrow text-ink-subtle uppercase">PGP fingerprint</h2>
      {/* Mono is reserved for machine-readable strings: this and code blocks. */}
      <p class="font-mono text-caption max-w-fingerprint wrap-anywhere">
        {fingerprint}
      </p>
    </div>
  </div>
</footer>
