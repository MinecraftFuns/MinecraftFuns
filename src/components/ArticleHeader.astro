---
import { dateLocaleOf, type Lang, readingTimeIn } from "../lib/lang.ts";
import type { PostTag } from "../lib/posts.ts";
import { formatDateIn, SITE_TIME_ZONE, type IsoDate } from "../lib/time.ts";
import type { Href } from "../lib/url.ts";
import { INTRO, INTRO_EXTRA, INTRO_LEDE } from "./intro.ts";
import PostTags from "./PostTags.astro";

/** Post header; shared intro styles keep publication metadata in the same block. */
type Props = {
  readonly title: string;
  readonly description: string;
  readonly date: IsoDate;
  /** Content language controls date locale; timezone remains site-wide. */
  readonly lang: Lang;
  readonly readingMinutes: number;
  readonly tags: readonly PostTag[];
  /** Other renditions, labeled in each target language. */
  readonly alternates?:
    | readonly {
        readonly href: Href;
        readonly hrefLang: string;
        readonly label: string;
      }[]
    | undefined;
};

const {
  title,
  description,
  date,
  lang,
  readingMinutes,
  tags,
  alternates = [],
} = Astro.props;

const { spacing, title: titleClass } = INTRO.page;

const displayDate = formatDateIn(date, SITE_TIME_ZONE, dateLocaleOf(lang));
---

<header class:list={["border-hairline border-b", spacing]}>
  <p class="meta flex items-center gap-2xs">
    <time datetime={date}>{displayDate}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTimeIn(lang, readingMinutes, "full")}</span>
    {
      alternates.map((alternate) => (
        <>
          <span aria-hidden="true">·</span>
          <a
            class="link-muted"
            href={alternate.href}
            hreflang={alternate.hrefLang}
            lang={alternate.hrefLang}
          >
            {alternate.label}
          </a>
        </>
      ))
    }
  </p>
  <h1 class:list={["text-ink mt-xs", titleClass]}>{title}</h1>
  <p class:list={[INTRO_LEDE]}>{description}</p>
  {/* Index reuses PostTags with different spacing. */}
  {
    tags.length > 0 && (
      <div class:list={[INTRO_EXTRA]}>
        <PostTags tags={tags} />
      </div>
    )
  }
</header>
