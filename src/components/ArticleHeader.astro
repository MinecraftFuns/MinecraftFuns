---
import type { PostTag } from "../lib/posts.ts";
import { formatIsoDate, type IsoDate } from "../lib/time.ts";
import { INTRO } from "./intro.ts";
import PostTags from "./PostTags.astro";

/**
 * A post's opening block.
 *
 * The same opening as `PageIntro`'s `page` kind, with publication metadata
 * where an eyebrow would go. The spacing and title role come from `INTRO`
 * rather than being written out again, which is what the post page used to do:
 * `pt-xl pb-lg` and `text-display-md` spelled twice, in two files, with nothing
 * to notice if one moved.
 *
 * `datetime` carries the machine-readable date and the text the human-readable
 * one, both rendered from a single validated value.
 *
 * A post, and only a post. `DocHeader` is its own component rather than this
 * one with the date made optional: a doc is not a post that happens to lack a
 * date, and collapsing the two would mean every later change to how a post is
 * introduced arrives in the docs whether it suits them or not.
 */
type Props = {
  readonly title: string;
  readonly description: string;
  readonly date: IsoDate;
  readonly readingMinutes: number;
  readonly tags: readonly PostTag[];
};

const { title, description, date, readingMinutes, tags } = Astro.props;

const { spacing, title: titleClass } = INTRO.page;
---

<header class:list={["border-hairline border-b", spacing]}>
  <p class="meta flex items-center gap-2xs">
    <time datetime={date}>{formatIsoDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes} min read</span>
  </p>
  <h1 class:list={["text-ink mt-xs", titleClass]}>{title}</h1>
  <p class="text-ink-muted mt-sm max-w-measure text-body-lg">{description}</p>
  {
    /* The gap belongs to this header, not to the tag list, which is also used
      on the blog index where the spacing above it is different. Conditioned on
      the same emptiness `PostTags` checks, so no margin is left behind when a
      post carries no tags. */
  }
  {
    tags.length > 0 && (
      <div class="mt-md">
        <PostTags tags={tags} />
      </div>
    )
  }
</header>
