---
import type { Project } from "../config";

type Props = { project: Project };

const { project } = Astro.props;
const Tag = project.href ? "a" : "div";
---

<Tag
  class="card"
  href={project.href}
  data-interactive={project.href ? "" : undefined}
>
  <div class="card__head">
    <h3 class="card__title">{project.title}</h3>
    <span class="card__year">{project.year}</span>
  </div>

  <p class="card__body">{project.description}</p>

  <div class="card__foot">
    <ul class="tags" role="list">
      {project.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    {
      project.status === "archived" && (
        <span class="badge">Archived</span>
      )
    }
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-md);
    background-color: var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  /* Elevation is a surface step plus a stronger hairline. No shadows. */
  .card[data-interactive]:hover {
    background-color: var(--surface-2);
    border-color: var(--hairline-strong);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .card__title {
    font-size: var(--text-card-title);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-card-title);
    color: var(--ink);
  }

  .card__year {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ink-tertiary);
    flex-shrink: 0;
  }

  .card__body {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--ink-subtle);
    margin-block-end: auto;
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0;
  }

  .tag {
    font-size: var(--text-caption);
    color: var(--ink-subtle);
  }

  .tag + .tag::before {
    content: "·";
    margin-inline-end: var(--space-3xs);
    color: var(--ink-tertiary);
  }

  /* Pill radius is allowed here — badges are the exception, buttons are not. */
  .badge {
    flex-shrink: 0;
    padding: 2px var(--space-2xs);
    background-color: var(--surface-2);
    border-radius: var(--radius-pill);
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }
</style>
