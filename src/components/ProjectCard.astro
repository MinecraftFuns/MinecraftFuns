---
import type { Project, ProjectStatus } from "../config.ts";

type Props = { readonly project: Project };

const { project } = Astro.props;

/*
 * The element type *is* the witness that a project is linked. The previous
 * version derived that same fact twice — once to pick `a` versus `div`, and
 * again to emit a `data-interactive` attribute for the hover rule — leaving two
 * encodings of one state that nothing forced to agree. Styling `a.card:hover`
 * reads the decision off the DOM instead of restating it.
 */
const Tag = project.href === undefined ? "div" : "a";

/*
 * Total elimination over a closed sum. `null` means "this state shows no
 * badge", which is a decision the author made, not a value that went missing —
 * and adding a third status makes this object a type error until it is
 * classified.
 */
const STATUS_BADGE: Readonly<Record<ProjectStatus, string | null>> = {
  active: null,
  archived: "Archived",
};

const badge = STATUS_BADGE[project.status];
---

<Tag class="card" href={project.href}>
  <div class="card__head">
    <h3 class="card__title">{project.title}</h3>
    <span class="card__year">{project.year}</span>
  </div>

  <p class="card__body">{project.description}</p>

  <div class="card__foot">
    <ul class="tags" role="list">
      {project.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    {badge !== null && <span class="badge">{badge}</span>}
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-md);
    background-color: var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  /* Elevation is a surface step plus a stronger hairline. No shadows. */
  a.card:hover {
    background-color: var(--surface-2);
    border-color: var(--hairline-strong);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .card__title {
    font-size: var(--text-card-title);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-card-title);
    color: var(--ink);
  }

  .card__year {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ink-tertiary);
    flex-shrink: 0;
  }

  .card__body {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--ink-subtle);
    margin-block-end: auto;
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0;
  }

  .tag {
    font-size: var(--text-caption);
    color: var(--ink-subtle);
  }

  .tag + .tag::before {
    content: "·";
    margin-inline-end: var(--space-3xs);
    color: var(--ink-tertiary);
  }

  /* Pill radius is allowed here — badges are the exception, buttons are not. */
  .badge {
    flex-shrink: 0;
    padding: 2px var(--space-2xs);
    background-color: var(--surface-2);
    border-radius: var(--radius-pill);
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }
</style>
