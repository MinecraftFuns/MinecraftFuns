---
import type { Project } from "../config/projects.ts";
import { badgeFor } from "../lib/projects.ts";

type Props = { readonly project: Project };

const { project } = Astro.props;

/*
 * The element type *is* the witness that a project is linked. The previous
 * version derived that same fact twice: once to pick `a` versus `div`, and
 * again to emit a `data-interactive` attribute for the hover rule, leaving
 * two encodings of one state that nothing forced to agree. A `group-hover`
 * would restate it a third time, so the hover styling is scoped by `a:hover`
 * in the one place a link is actually produced.
 */
const Tag = project.href === undefined ? "div" : "a";

/* The label lives beside the status it belongs to, in config. `null` means
   "this state shows no badge", a decision, not a value that went missing. */
const badge = badgeFor(project.status);

/* Elevation is a surface step plus a stronger hairline. There are no shadow
   utilities in this theme, so that is enforced rather than merely intended. */
const INTERACTIVE =
  "hover:border-hairline-strong hover:bg-surface-2 transition-colors";
---

<Tag
  class:list={[
    "border-hairline bg-surface-1 flex h-full flex-col gap-xs rounded-lg border p-md no-underline",
    project.href !== undefined && INTERACTIVE,
  ]}
  href={project.href}
>
  <div class="flex items-baseline justify-between gap-2xs">
    <h3 class="text-card-title text-ink">{project.title}</h3>
    <span class="meta shrink-0">
      {project.year}
    </span>
  </div>

  <p class="note mb-auto">{project.description}</p>

  <div class="mt-2xs flex items-center justify-between gap-2xs">
    <ul class="flex flex-wrap gap-3xs text-caption text-ink-subtle" role="list">
      {
        project.tags.map((tag, index) => (
          <li>
            {index > 0 && <span class="text-ink-tertiary me-3xs">·</span>}
            {tag}
          </li>
        ))
      }
    </ul>
    {
      /* Pill radius is allowed here; badges are the exception, buttons are not. */
      badge !== null && (
        <span class="bg-surface-2 text-ink-muted shrink-0 rounded-pill px-2xs py-3xs text-caption">
          {badge}
        </span>
      )
    }
  </div>
</Tag>
