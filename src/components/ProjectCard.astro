---
import type { Project } from "../config/projects.ts";
import { badgeFor, spanOf } from "../lib/projects.ts";
import { currentYear } from "../lib/time.ts";

type Props = { readonly project: Project };

const { project } = Astro.props;

/* Both derived from the one span. `null` means "this state shows no badge", a
   decision rather than a value that went missing. */
const badge = badgeFor(project);
const span = spanOf(project, currentYear());
---

{
  /* Always an anchor: `href` is required, so the card has one shape and the
     hover treatment needs no condition to guard it. Elevation is a surface
     step plus a stronger hairline; this theme has no shadow utilities. */
}
<a
  class="border-hairline bg-surface-1 hover:border-hairline-strong hover:bg-surface-2 flex h-full flex-col gap-xs rounded-lg border p-md no-underline transition-colors"
  href={project.href}
>
  <div class="flex items-baseline justify-between gap-2xs">
    <h3 class="text-card-title text-ink">{project.title}</h3>
    <span class="meta shrink-0">
      {span}
    </span>
  </div>

  <p class="note mb-auto">{project.description}</p>

  <div class="mt-2xs flex items-center justify-between gap-2xs">
    <ul class="flex flex-wrap gap-3xs text-caption text-ink-subtle" role="list">
      {
        project.tags.map((tag, index) => (
          <li>
            {index > 0 && <span class="text-ink-tertiary me-3xs">·</span>}
            {tag}
          </li>
        ))
      }
    </ul>
    {
      /* Pill radius is allowed here; badges are the exception, buttons are not. */
      badge !== null && (
        <span class="bg-surface-2 text-ink-muted shrink-0 rounded-pill px-2xs py-3xs text-caption">
          {badge}
        </span>
      )
    }
  </div>
</a>
