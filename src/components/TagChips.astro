---
import Button from "./Button.astro";
import type { Taxon } from "../lib/taxonomy.ts";
import { tagHref, type PostSummary, type PostTag } from "../lib/posts.ts";

/** Tag-directory controls with post counts. */
type Props = {
  readonly tags: readonly Taxon<PostTag, PostSummary>[];
};

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap items-center gap-2xs" role="list">
      {tags.map((taxon) => (
        <li>
          <Button href={tagHref(taxon.label)} tone="secondary" size="compact">
            {taxon.label}
            <span class="text-ink-subtle ms-2xs tabular-nums">{taxon.items.length}</span>
          </Button>
        </li>
      ))}
    </ul>
  )
}
