---
import { INTRO, type IntroKind } from "./intro.ts";

/**
 * The opening block of every page: eyebrow, title, and optional lede.
 *
 * `kind` is a closed sum over the two openings this site has, and `INTRO` maps
 * it to both padding and title role at once. The record lives in `intro.ts`
 * because `ArticleHeader` is the same opening with different metadata and must
 * resolve it from the same place.
 *
 * Titles carry no width cap. The frame is narrow enough to set the line length
 * itself, and `text-wrap: balance` handles the ragged edge; the three
 * different character caps this replaced were three guesses at one number.
 */
type Props = {
  readonly kind: IntroKind;
  readonly eyebrow: string;
  readonly title: string;
  readonly lede?: string;
};

const { kind, eyebrow, title, lede } = Astro.props;

const { spacing, title: titleClass } = INTRO[kind];

/*
 * The gap to whatever a page puts below the lede belongs here, not to the
 * page. Three pages each brought their own and one of them disagreed: two
 * spaced their buttons by `lg` and About spaced its prose by `md`, so one
 * structural position had two answers. Rendered first so an empty slot leaves
 * no margin behind.
 */
const extra = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasExtra = extra.trim() !== "";
---

<section class:list={[spacing]}>
  <p class="text-eyebrow text-ink-subtle uppercase">{eyebrow}</p>
  <h1 class:list={["mt-xs text-ink", titleClass]}>{title}</h1>
  {
    lede !== undefined && (
      <p class="mt-md max-w-measure text-body-lg text-ink-muted">{lede}</p>
    )
  }
  {hasExtra && <div class="mt-lg" set:html={extra} />}
</section>
