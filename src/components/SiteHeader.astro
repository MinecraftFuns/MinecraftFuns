---
import { nav, site } from "../config.ts";
import { isWithin, withBase } from "../lib/url.ts";

const { pathname } = Astro.url;

/*
 * Resolve each nav target once, then reuse it for both the link and the
 * current-section test. `Astro.url.pathname` already carries the deployment's
 * base path, so the comparison has to be made against a resolved target rather
 * than the raw config value.
 */
const items = nav.map((item) => ({
  ...item,
  target: withBase(item.href),
}));
---

<header
  class="border-hairline bg-veil sticky top-0 z-50 border-b backdrop-blur-md"
>
  <div
    class="mx-auto flex w-full max-w-frame items-center gap-md px-md min-h-nav md:px-lg"
  >
    <a
      class="text-control text-ink inline-flex min-h-control items-center gap-2xs no-underline"
      href={withBase("/")}
      aria-label={`${site.name} — home`}
    >
      {/* One of the few sanctioned uses of the accent. Sized to the cap height
          of the name beside it, and on the 4px base like everything else. */}
      <span class="bg-accent size-xs rounded-xs" aria-hidden="true"></span>
      <span class="hidden xs:inline">{site.name}</span>
    </a>

    {/*
      The chips carry inline padding, so the nav is pulled outward by exactly
      that padding: what should line up with the frame edge is the last label,
      not the hover box around it.
    */}
    <nav class="ms-auto -me-2xs xs:-me-xs" aria-label="Primary">
      <ul class="flex items-center" role="list">
        {
          items.map((item) => (
            <li>
              {/*
                `flex`, not `inline-flex`: an inline box would sit on the list
                item's baseline and inherit its half-leading, making the chip
                taller than the token says and misaligning it against the brand.
              */}
              <a
                class="text-body text-ink-subtle hover:bg-surface-1 hover:text-ink current:text-ink flex min-h-control items-center rounded-md px-2xs no-underline transition-colors xs:px-xs"
                href={item.target}
                aria-current={isWithin(pathname, item.target) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
