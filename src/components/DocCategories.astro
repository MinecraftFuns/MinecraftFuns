---
import { categoryHref, type DocCategory } from "../lib/docs.ts";
import Button from "./Button.astro";

/** Docs-only category controls; shared `Button` centralizes their styling. */
type Props = { readonly categories: readonly DocCategory[] };

const { categories } = Astro.props;
---

{
  categories.length > 0 && (
    <nav class="flex flex-wrap gap-2xs" aria-label="Categories">
      {categories.map((category) => (
        <Button href={categoryHref(category)} tone="secondary" size="compact">
          {category}
        </Button>
      ))}
    </nav>
  )
}
