---
import ChipList from "./ChipList.astro";
import { categoryHref, type DocCategory } from "../lib/docs.ts";

/** The docs' categories as a named landmark; the row itself is a `ChipList`. */
type Props = { readonly categories: readonly DocCategory[] };

const { categories } = Astro.props;

const chips = categories.map((category) => ({
  label: category,
  href: categoryHref(category),
}));
---

{
  chips.length > 0 && (
    <nav aria-label="Categories">
      <ChipList chips={chips} />
    </nav>
  )
}
