---
import Button from "./Button.astro";
import { nextHref, pageHref, prevHref, type Page } from "../lib/paging.ts";
import type { RootedPath } from "../schema.ts";

/** Pagination controls; page one links to the listing route, not `/page/1/`. */
type Props = {
  readonly base: RootedPath;
  readonly page: Page<unknown>;
  /** Accessible name for the pagination control. */
  readonly label: string;
};

const { base, page, label } = Astro.props;

const previous = prevHref(base, page);
const next = nextHref(base, page);

const numbers = Array.from({ length: page.total }, (_, index) => ({
  index: index + 1,
  href: pageHref(base, index + 1),
  current: index + 1 === page.index,
}));
---

{
  page.total > 1 && (
    <nav
      class="border-hairline mt-xl flex items-center gap-xs border-t pt-lg"
      aria-label={label}
    >
      {previous !== undefined && (
        <Button href={previous} tone="secondary" size="compact">
          Newer
        </Button>
      )}

      <ol
        class="text-body-sm text-ink-tertiary flex flex-wrap items-center gap-2xs"
        role="list"
      >
        {numbers.map(({ index, href, current }) => (
          <li>
            {current ? (
              <span class="text-ink px-2xs tabular-nums" aria-current="page">
                {index}
              </span>
            ) : (
              <a class="link-muted px-2xs tabular-nums" href={href}>
                {index}
              </a>
            )}
          </li>
        ))}
      </ol>

      {next !== undefined && (
        <Button href={next} tone="secondary" size="compact">
          Older
        </Button>
      )}
    </nav>
  )
}
