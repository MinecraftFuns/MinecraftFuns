---
import type { Href } from "../lib/url.ts";

/** Centralize control styling in closed, fully scannable tone/size variants. */

/**
 * How loudly the control rests. The gesture is identical across all three,
 * and lives in `.control`; a tone supplies only the four colours it walks.
 */
export type ButtonTone = "primary" | "secondary" | "quiet";

/** `control` is full-size, `compact` the tag-sized WCAG target, `nav` the masthead. */
export type ButtonSize = "control" | "compact" | "nav";

type Props = {
  readonly href: Href;
  readonly tone: ButtonTone;
  /** Required rather than defaulted: a control's size is a decision. */
  readonly size: ButtonSize;
  /** Marks the control as the page the reader is already on. */
  readonly current?: boolean;
};

const { href, tone, size, current = false } = Astro.props;

const TONE: Readonly<Record<ButtonTone, string>> = {
  primary: "control-primary",
  secondary: "control-secondary",
  quiet: "control-quiet current:text-ink",
};

const SIZE: Readonly<Record<ButtonSize, string>> = {
  control: "min-h-control px-sm text-control",
  compact: "min-h-target px-2xs py-3xs text-body-sm",
  /* Regular weight, unlike the other two: a masthead lists, it does not urge. */
  nav: "min-h-control px-2xs text-body xs:px-xs",
};
---

<a
  class:list={[
    "control inline-flex items-center rounded-md no-underline",
    TONE[tone],
    SIZE[size],
  ]}
  href={href}
  aria-current={current ? "page" : undefined}
>
  <slot />
</a>
