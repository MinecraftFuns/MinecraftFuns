---
import type { Href } from "../lib/url.ts";

/** Centralize control styling in closed, fully scannable tone/size variants. */
export type ButtonTone = "primary" | "secondary";

/** `control` is full-size; `compact` is the tag-sized WCAG target. */
export type ButtonSize = "control" | "compact";

type Props = {
  readonly href: Href;
  readonly tone: ButtonTone;
  /** Required rather than defaulted: a control's size is a decision. */
  readonly size: ButtonSize;
};

const { href, tone, size } = Astro.props;

const TONE: Readonly<Record<ButtonTone, string>> = {
  primary:
    "border border-transparent bg-accent text-on-accent hover:bg-accent-hover transition-colors",
  secondary: "surface-interactive text-ink",
};

const SIZE: Readonly<Record<ButtonSize, string>> = {
  control: "min-h-control px-sm text-control",
  compact: "min-h-target px-2xs py-3xs text-body-sm",
};
---

<a
  class:list={[
    "inline-flex items-center rounded-md no-underline",
    TONE[tone],
    SIZE[size],
  ]}
  href={href}
>
  <slot />
</a>
