---
import Button from "./Button.astro";
import type { Href } from "../lib/url.ts";

/**
 * The way out of an article or a slice of an index.
 *
 * Full size, unlike a section's trailing control: this one stands alone under
 * a rule rather than sharing a row with a heading. The direction is fixed
 * here rather than accepted as a prop, because a back link that pointed
 * onward would be lying about what it does.
 */
type Props = {
  readonly href: Href;
  readonly label: string;
};

const { href, label } = Astro.props;
---

<footer class="border-hairline border-t pt-md">
  <Button href={href} tone="quiet" size="control" direction="back">{label}</Button>
</footer>
