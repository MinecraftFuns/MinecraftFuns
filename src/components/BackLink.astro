---
import Button from "./Button.astro";
import type { Href } from "../lib/url.ts";

/** Shared index backlink; decorative arrow hidden from assistive technology. */
type Props = {
  readonly href: Href;
  readonly label: string;
};

const { href, label } = Astro.props;
---

<footer class="border-hairline border-t pt-md">
  {
    /* Full size, unlike the section trailing control: this one stands alone
      under an article and is the way out of it. */
  }
  <Button href={href} tone="secondary" size="control">
    <span class="me-3xs" aria-hidden="true">←</span>
    {label}
  </Button>
</footer>
