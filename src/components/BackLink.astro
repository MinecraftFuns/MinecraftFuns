---
import type { Href } from "../lib/url.ts";

/** Shared index backlink; decorative arrow hidden from assistive technology. */
type Props = {
  readonly href: Href;
  readonly label: string;
};

const { href, label } = Astro.props;
---

<footer class="border-hairline border-t pt-md">
  <a class="link inline-flex min-h-target items-center gap-3xs" href={href}>
    <span aria-hidden="true">←</span>
    {label}
  </a>
</footer>
