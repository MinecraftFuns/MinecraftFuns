---
import type { HttpsUrl } from "../schema.ts";

/**
 * A quotation, set as page furniture rather than as content.
 *
 * `figure`/`blockquote`/`figcaption` rather than a styled `div`: the
 * attribution is the caption *of* the quotation, and only the figure element
 * says so to a screen reader. `cite` carries the source for machines; the
 * visible link is the one a human follows.
 */
/* Source is required; unverifiable quotations are excluded. */
type Props = {
  readonly quote: string;
  readonly author: string;
  readonly source: { readonly href: HttpsUrl; readonly label: string };
};

const { quote, author, source } = Astro.props;
---

<figure class="border-hairline-strong my-lg border-l pl-md">
  <blockquote class="max-w-measure text-body-lg text-ink-muted" cite={source.href}>
    {quote}
  </blockquote>

  {
    /*
     * Em dash is typographic convention here, not substitute punctuation.
     */
  }
  <figcaption class="note mt-xs">
    &mdash; {author},{" "}
    <a class="link" href={source.href}>{source.label}</a>
  </figcaption>
</figure>
