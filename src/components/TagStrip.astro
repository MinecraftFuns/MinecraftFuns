---
import Button from "./Button.astro";
import type { Browse } from "../lib/browse.ts";
import { tagHref, type PostSummary, type PostTag } from "../lib/posts.ts";
import type { Taxon } from "../lib/taxonomy.ts";
import { routeUrl } from "../lib/url.ts";

/** Ranked tag preview plus a link to the full directory. */
type Props = {
  readonly strip: Browse<Taxon<PostTag, PostSummary>>;
};

const { strip } = Astro.props;
---

<ul class="flex flex-wrap gap-2xs" role="list">
  {
    strip.shown.map((taxon) => (
      <li>
        <Button href={tagHref(taxon.label)} tone="secondary" size="compact">
          {taxon.label}
        </Button>
      </li>
    ))
  }

  {
    strip.rest > 0 && (
      <li>
        <a
          class="link-muted text-body-sm inline-flex min-h-target items-center px-2xs"
          href={routeUrl("/blog/tags")}
        >
          {strip.rest} more tags
        </a>
      </li>
    )
  }
</ul>
