---
import { tagHref, type PostTag } from "../lib/posts.ts";
import Button from "./Button.astro";

/** Typed post tags rendered as shared controls; empty input renders nothing. */
type Props = { readonly tags: readonly PostTag[] };

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap items-center gap-2xs" role="list">
      {tags.map((tag) => (
        <li>
          <Button href={tagHref(tag)} tone="secondary" size="compact">
            {tag}
          </Button>
        </li>
      ))}
    </ul>
  )
}
