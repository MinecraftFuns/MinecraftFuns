---
import Button from "./Button.astro";
import type { Href } from "../lib/url.ts";

/** Ruled section with closed trailing variants. */
export type SectionTrailing =
  | { readonly tag: "link"; readonly href: Href; readonly label: string }
  | { readonly tag: "count"; readonly value: number };

type Props = {
  readonly id: string;
  readonly title: string;
  readonly blurb?: string;
  readonly trailing?: SectionTrailing;
};

const { id, title, blurb, trailing } = Astro.props;

/* Type-only exhaustive check; Astro has no switch. */
type Unhandled = Exclude<SectionTrailing["tag"], "link" | "count">;

const _exhaustive: [Unhandled] extends [never] ? true : never = true;
void _exhaustive;
---

<section class="py-lg" aria-labelledby={id}>
  <div
    class="border-hairline mb-md flex items-baseline justify-between gap-md border-b pb-md"
  >
    <div>
      <h2 class="text-headline text-ink" id={id}>{title}</h2>
      {blurb !== undefined && <p class="note mt-3xs">{blurb}</p>}
    </div>

    {
      trailing?.tag === "link" && (
        <div class="shrink-0">
          {/* Compact, so the control sits on the heading's row rather than
              growing it. */}
          <Button href={trailing.href} tone="secondary" size="compact">
            {trailing.label}
          </Button>
        </div>
      )
    }
    {trailing?.tag === "count" && <span class="meta shrink-0">{trailing.value}</span>}
  </div>

  <slot />
</section>
