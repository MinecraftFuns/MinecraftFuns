---
import type { PostSummary } from "../lib/posts.ts";
import { formatIsoDate } from "../lib/time.ts";

type Props = { readonly post: PostSummary };

const { post } = Astro.props;

/*
 * `datetime` carries the machine-readable calendar date and the text carries
 * the human-readable one. They are now two renderings of a single validated
 * value rather than two independent computations that can disagree, which is
 * exactly how the previous version shipped `datetime="2026-07-14"` next to the
 * text "Jul 13, 2026".
 */
const displayDate = formatIsoDate(post.date);
---

{
  /*
  Adapted from Linear's changelog row rather than its card grid: writing is a
  chronological list, and rows stay scannable at length where a grid would not.

  Two regimes. Narrow is two columns with the title spanning both and the date
  dropping beneath it, so the content column is never squeezed. At `md` every
  explicit placement is released and the three cells auto-place across
  `grid-cols-row`.
*/
}
<a
  class="group border-hairline grid grid-cols-row-stacked items-baseline gap-md border-b py-md no-underline md:grid-cols-row"
  href={post.href}
>
  <time
    class="meta col-start-1 row-start-2 whitespace-nowrap md:row-auto"
    datetime={post.date}
  >
    {displayDate}
  </time>

  <div class="col-span-full md:col-auto">
    <h3 class="text-row-title text-ink group-hover:text-accent transition-colors">
      {post.title}
    </h3>
    <p class="note mt-3xs max-w-measure">
      {post.description}
    </p>
  </div>

  <span class="meta whitespace-nowrap">
    {post.readingMinutes} min
  </span>
</a>
