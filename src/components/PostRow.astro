---
import { bcp47Of, nativeNameOf, readingTimeIn, SITE_LANG } from "../lib/lang.ts";
import type { PostSummary } from "../lib/posts.ts";
import { formatIsoDate } from "../lib/time.ts";

type Props = { readonly post: PostSummary };

const { post } = Astro.props;

/* Non-primary renditions show their native language. */
const badge =
  post.lang === SITE_LANG
    ? undefined
    : { label: nativeNameOf(post.lang), lang: bcp47Of(post.lang) };
const displayDate = formatIsoDate(post.date);
---

<a
  class="group border-hairline grid grid-cols-row-stacked items-baseline gap-md border-b py-md no-underline md:grid-cols-row"
  href={post.href}
>
  <time
    class="meta col-start-1 row-start-2 whitespace-nowrap md:row-auto"
    datetime={post.date}
  >
    {displayDate}
  </time>

  <div class="col-span-full md:col-auto">
    <h3 class="row-title">
      {post.title}
    </h3>
    <p class="note mt-3xs max-w-measure">
      {post.description}
    </p>
  </div>

  <span class="meta whitespace-nowrap">
    {readingTimeIn(SITE_LANG, post.readingMinutes, "compact")}{
      badge && (
        <>
          {" "}
          <span aria-hidden="true">·</span> <span lang={badge.lang}>{badge.label}</span>
        </>
      )
    }
  </span>
</a>
