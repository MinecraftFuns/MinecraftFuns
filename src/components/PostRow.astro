---
import type { Post } from "../config";

type Props = { post: Post };

const { post } = Astro.props;
const date = new Date(post.date);
---

<a class="row" href={post.href}>
  <time class="row__date" datetime={post.date}>
    {
      date.toLocaleDateString("en-CA", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })
    }
  </time>

  <div class="row__content">
    <h3 class="row__title">{post.title}</h3>
    <p class="row__description">{post.description}</p>
  </div>

  <span class="row__meta">{post.readingTime}</span>
</a>

<style>
  /*
   * Adapted from Linear's changelog-row rather than its card grid: writing is
   * a chronological list, and rows stay scannable at length where a grid of
   * cards would not.
   */
  .row {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
  }

  .row:hover .row__title {
    color: var(--accent);
  }

  .row__date,
  .row__meta {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ink-tertiary);
    white-space: nowrap;
  }

  .row__title {
    font-size: var(--text-body-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-card-title);
    color: var(--ink);
    transition: color var(--duration-fast) var(--ease);
  }

  .row__description {
    margin-top: var(--space-3xs);
    font-size: var(--text-body-sm);
    color: var(--ink-subtle);
    max-width: var(--measure);
  }

  @media (max-width: 44rem) {
    .row {
      grid-template-columns: 1fr auto;
    }

    /* Date drops under the title rather than squeezing the content column. */
    .row__date {
      grid-row: 2;
      grid-column: 1;
    }

    .row__content {
      grid-column: 1 / -1;
    }
  }
</style>
