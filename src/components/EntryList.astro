---
import type { Href } from "../lib/url.ts";

/** Label/value list with closed rendering variants. */
export type EntryBody =
  | {
      readonly tag: "lines";
      readonly title: string;
      readonly notes: readonly string[];
    }
  | { readonly tag: "link"; readonly href: Href; readonly label: string }
  /** Machine-readable value such as a fingerprint or hash. */
  | { readonly tag: "mono"; readonly value: string };

export type Entry = {
  readonly label: string;
  readonly body: EntryBody;
};

type Props = { readonly entries: readonly Entry[] };

const { entries } = Astro.props;

/* Type-only exhaustive check; Astro has no switch. */
type Unhandled = Exclude<EntryBody["tag"], "lines" | "link" | "mono">;

const _exhaustive: [Unhandled] extends [never] ? true : never = true;
void _exhaustive;
---

<dl>
  {
    entries.map(({ label, body }) => (
      <div class="border-hairline grid gap-x-md gap-y-2xs border-b py-sm last:border-b-0 sm:grid-cols-entry sm:items-baseline">
        <dt class="meta">{label}</dt>
        <dd>
          {body.tag === "lines" && (
            <>
              <p class="text-ink text-control">{body.title}</p>
              {body.notes.map((note) => (
                <p class="note">{note}</p>
              ))}
            </>
          )}
          {body.tag === "link" && (
            <a class="link text-control" href={body.href}>
              {body.label}
            </a>
          )}
          {body.tag === "mono" && (
            <span class="text-ink-muted font-mono text-body wrap-anywhere">
              {body.value}
            </span>
          )}
        </dd>
      </div>
    ))
  }
</dl>
