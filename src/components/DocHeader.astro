---
import { categoryHref, type DocCategory } from "../lib/docs.ts";
import { readingTimeIn, SITE_LANG } from "../lib/lang.ts";
import { INTRO, INTRO_LEDE } from "./intro.ts";

/** Doc opening; separate from the post header because metadata differs. */
type Props = {
  readonly title: string;
  readonly description: string;
  readonly category: DocCategory;
  readonly readingMinutes: number;
};

const { title, description, category, readingMinutes } = Astro.props;

const { spacing, title: titleClass } = INTRO.page;
---

<header class:list={["border-hairline border-b", spacing]}>
  {/* Inline category link qualifies for WCAG 2.5.8's exception. */}
  <p class="meta flex items-center gap-2xs">
    <a class="link-muted" href={categoryHref(category)}>
      {category}
    </a>
    <span aria-hidden="true">·</span>
    <span>{readingTimeIn(SITE_LANG, readingMinutes, "full")}</span>
  </p>
  <h1 class:list={["text-ink mt-xs", titleClass]}>{title}</h1>
  <p class:list={[INTRO_LEDE]}>{description}</p>
</header>
