---
/**
 * Three-state theme control: system → light → dark → system.
 *
 * Because theming is built on light-dark(), switching themes is a single
 * `color-scheme` assignment on <html> — there is no class list to keep in
 * sync and no second set of CSS overrides to maintain.
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Change color theme"
>
  <span class="theme-toggle__icon" data-icon="system" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25">
      <rect x="1.5" y="2.5" width="13" height="9" rx="1.5"></rect>
      <path d="M5 13.5h6" stroke-linecap="round"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon" data-icon="light" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25">
      <circle cx="8" cy="8" r="3.25"></circle>
      <path
        d="M8 1v1.5M8 13.5V15M15 8h-1.5M2.5 8H1M12.95 3.05l-1.06 1.06M4.11 11.89l-1.06 1.06M12.95 12.95l-1.06-1.06M4.11 4.11L3.05 3.05"
        stroke-linecap="round"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon" data-icon="dark" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25">
      <path
        d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"
        stroke-linejoin="round"></path>
    </svg>
  </span>
  <span class="visually-hidden" data-theme-label>System theme</span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--ink-subtle);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
    background-color: var(--surface-1);
    border-color: var(--hairline);
  }

  /* All three icons occupy one grid cell; only the active one is shown. */
  .theme-toggle__icon {
    grid-area: 1 / 1;
    display: none;
  }

  .theme-toggle__icon svg {
    width: 16px;
    height: 16px;
  }

  :global(html[data-theme-pref="system"]) .theme-toggle__icon[data-icon="system"],
  :global(html[data-theme-pref="light"]) .theme-toggle__icon[data-icon="light"],
  :global(html[data-theme-pref="dark"]) .theme-toggle__icon[data-icon="dark"] {
    display: block;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Touch viewports get a full-size tap target. */
  @media (pointer: coarse) {
    .theme-toggle {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  type Pref = "system" | "light" | "dark";

  const ORDER: readonly Pref[] = ["system", "light", "dark"];
  const LABELS: Record<Pref, string> = {
    system: "System theme",
    light: "Light theme",
    dark: "Dark theme",
  };

  function apply(pref: Pref) {
    const root = document.documentElement;
    root.dataset.themePref = pref;
    // An empty string clears the inline style and defers to the stylesheet's
    // `color-scheme: light dark`, which is what "system" means here.
    root.style.colorScheme = pref === "system" ? "" : pref;

    for (const label of document.querySelectorAll("[data-theme-label]")) {
      label.textContent = LABELS[pref];
    }
  }

  function current(): Pref {
    const pref = document.documentElement.dataset.themePref;
    return pref === "light" || pref === "dark" ? pref : "system";
  }

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]!;
      apply(next);
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Private browsing or blocked storage: the theme still applies for
        // this page view, it just will not persist.
      }
    });
  }

  // Re-apply after client-side navigation, which replaces the <head>.
  document.addEventListener("astro:after-swap", () => apply(current()));
</script>
