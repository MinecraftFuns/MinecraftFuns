---
import "katex/dist/katex.min.css";

import BackLink from "../components/BackLink.astro";
import BaseLayout from "./BaseLayout.astro";
import type { Href } from "../lib/url.ts";
import type { RootedPath } from "../schema.ts";
import type { Chrome } from "./chrome.ts";

/** Shared long-form shell; header slot keeps post and doc metadata distinct. */
type Props = {
  readonly title: string;
  readonly description: string;
  readonly chrome?: Chrome;
  readonly back: { readonly href: Href; readonly label: string };
  /* Forward head metadata untouched; this layout does not interpret language. */
  readonly lang?: string | undefined;
  readonly canonicalRoute?: RootedPath | undefined;
  readonly alternates?:
    readonly { readonly hrefLang: string; readonly route: RootedPath }[] | undefined;
};

const { title, description, chrome, back, lang, canonicalRoute, alternates } =
  Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  chrome={chrome}
  lang={lang}
  canonicalRoute={canonicalRoute}
  alternates={alternates}
>
  <article class="pb-lg">
    <slot name="header" />

    {
      /*
       * Layout owns the gap between sibling header and back link.
       */
    }
    <div class="prose mt-lg mb-xl">
      <slot />
    </div>

    <BackLink href={back.href} label={back.label} />
  </article>
</BaseLayout>
