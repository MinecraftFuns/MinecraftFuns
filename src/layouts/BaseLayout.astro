---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site.ts";
import { assetUrl } from "../lib/url.ts";
import type { Chrome } from "./chrome.ts";

type Props = {
  readonly title?: string;
  readonly description?: string;
  /** Set on article pages so the OG type is accurate. */
  readonly type?: "website" | "article";
  readonly chrome?: Chrome;
};

const {
  title,
  description = site.description,
  type = "website",
  chrome = "site",
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;

/*
 * `Astro.site` is typed as optional because a project may leave it unset;
 * this one cannot, since `astro.config.mjs` assigns it unconditionally and
 * throws on a malformed value. Resolved once here so the absent case is
 * answered in one place instead of twice with two different answers: the
 * indexing test used to fall back to `""`, which is not an origin and quietly
 * meant "not primary".
 */
const deployedTo = Astro.site ?? new URL(site.canonicalOrigin);

const canonical = new URL(Astro.url.pathname, deployedTo);

/*
 * Only the primary origin should be indexed. The GitHub Pages build is a
 * mirror, and two indexed copies of one site compete as duplicates of each
 * other. robots.txt cannot say this there: a crawler reads it only from the
 * origin root, never from beneath a base path, so the request has to travel
 * in the document itself.
 */
const isPrimary = deployedTo.origin === new URL(site.canonicalOrigin).origin;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      The second half of sitemap discovery. robots.txt names the sitemap for
      crawlers that fetch it; this reaches the ones that do not, and it is the
      only mechanism that works at all beneath a base path, where robots.txt is
      never read.
    */}
    <link rel="sitemap" type="application/xml" href={assetUrl("/sitemap-index.xml")} />
    <link rel="icon" href={assetUrl("/favicon.svg")} type="image/svg+xml" />
    {!isPrimary && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      There is deliberately no theme script here. The system preference is the
      single source of truth, and `color-scheme: light dark` plus `light-dark()`
      resolve it in CSS before first paint, so there is no stored preference to
      restore, no state to desynchronise, and no flash to prevent.
    */}
  </head>

  <body class="bg-canvas text-ink font-sans text-body min-h-dvh antialiased">
    {/*
      `sr-only` plus `focus:not-sr-only` is the whole skip link: no offscreen
      transform to maintain, and it stays reachable if CSS transforms fail.
    */}
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-2xs focus:left-2xs focus:z-100 focus:inline-flex focus:min-h-control focus:items-center focus:rounded-md focus:bg-accent focus:px-sm focus:text-control focus:text-on-accent focus:no-underline"
      href="#main"
    >
      Skip to content
    </a>

    {chrome === "site" && <SiteHeader />}

    {/*
      The frame lives here, not in the pages. A page renders sections and has
      no way to state a width, so the column cannot differ between one page and
      the next, which it previously did, by 26rem.

      `outline-none` because this is a programmatic focus target for the skip
      link, not something the reader tabbed to.
    */}
    {/* The gap above the footer belongs to this layout, which owns both. */}
    <main
      class="mx-auto mb-section w-full max-w-frame px-md outline-none md:px-lg"
      id="main"
      tabindex="-1"
    >
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
