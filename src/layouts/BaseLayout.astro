---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site.ts";
import { orThrow } from "../prelude/adt.ts";
import { activeTarget, canonicalHref, indexable } from "../lib/deployment.ts";
import { siteDescription } from "../lib/identity.ts";
import { bcp47Of, SITE_LANG } from "../lib/lang.ts";
import { assetUrl, joinRoute } from "../lib/url.ts";
import type { RootedPath } from "../schema.ts";
import type { Chrome } from "./chrome.ts";

/**
 * A language alternate to declare in the head. Structural on purpose: the
 * producing domain (`lib/article.ts`) has its own name for this shape, and
 * the chrome depending on a blog module would invert the layering.
 */
type Alternate = {
  readonly hrefLang: string;
  readonly route: RootedPath;
};

/*
 * Every prop here has a default below, which is why each admits `undefined`
 * explicitly. Under `exactOptionalPropertyTypes` a bare `?:` means "omit me",
 * and a layout forwarding its own optional prop has no way to omit anything;
 * `| undefined` is the type saying the default answers both absences alike.
 */
type Props = {
  readonly title?: string | undefined;
  readonly description?: string | undefined;
  /** Set on article pages so the OG type is accurate. */
  readonly type?: "website" | "article" | undefined;
  readonly chrome?: Chrome | undefined;
  /** BCP 47 tag of the page's *content*, where it is not the site's own. */
  readonly lang?: string | undefined;
  /**
   * Site-relative route of the page this one is a copy of, where that is not
   * the page's own address: a non-default language rendition is served at two
   * routes, and only one of them is the URL to index.
   */
  readonly canonicalRoute?: RootedPath | undefined;
  /** Language alternates of this page, empty where it has none. */
  readonly alternates?: readonly Alternate[] | undefined;
};

const {
  title,
  description = siteDescription,
  type = "website",
  chrome = "site",
  lang = bcp47Of(SITE_LANG),
  canonicalRoute,
  alternates = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;

/*
 * Which deployment is being built, decided once, from the one declaration in
 * `config/deployments.ts`. Failure is a defect rather than an expected
 * outcome: a build that cannot identify its own target would emit canonical
 * URLs and an indexing policy that are guesses, so it fails instead.
 */
const target = orThrow(activeTarget(Astro.site), "deployment");

/*
 * The canonical URL names the *canonical* deployment, on every target.
 *
 * This is the whole point of modelling deployments: a page's authoritative
 * address is a fact about the site, not about the build that emitted it. Each
 * build used to canonicalise to its own origin, so the mirror declared itself
 * authoritative and then separately asked not to be indexed: two derivations
 * of one decision, disagreeing. Now a crawler landing on any copy is pointed
 * at the same URL.
 *
 * `canonicalRoute` overrides the page's own address for the one case where
 * they differ: a page that is a second serving of another. It arrives
 * site-relative and is mounted on the active base first, so it enters
 * `canonicalHref` in the same coordinate system `Astro.url.pathname` would.
 */
const deployed = (route: RootedPath): string => joinRoute(target.base, route);

const canonical = orThrow(
  canonicalHref(
    target,
    canonicalRoute === undefined ? Astro.url.pathname : deployed(canonicalRoute),
  ),
  "canonical URL",
);

/* Alternates resolve the same way: every href in the cluster points at the
   canonical deployment, whichever copy of the site emitted it. */
const alternateLinks = alternates.map(({ hrefLang, route }) => ({
  hrefLang,
  href: orThrow(canonicalHref(target, deployed(route)), `alternate ${hrefLang}`),
}));

/*
 * Only the canonical copy asks to be indexed; two indexed copies of one site
 * compete as duplicates. robots.txt cannot carry this to a mirror served
 * beneath a base path, because a crawler reads robots.txt only from the origin
 * root, so the request travels in the document itself.
 */
const isIndexable = indexable(target.role);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      /*
      Emitted on every page of a bilingual article, bare and suffixed alike:
      hreflang annotations must be reciprocal to be honoured, so each page of
      the cluster declares the whole cluster.
    */
    }
    {
      alternateLinks.map(({ hrefLang, href }) => (
        <link rel="alternate" hreflang={hrefLang} href={href} />
      ))
    }
    {
      /*
      The second half of sitemap discovery. robots.txt names the sitemap for
      crawlers that fetch it; this reaches the ones that do not, and it is the
      only mechanism that works at all beneath a base path, where robots.txt is
      never read.
    */
    }
    <link rel="sitemap" type="application/xml" href={assetUrl("/sitemap-index.xml")} />
    <link rel="icon" href={assetUrl("/favicon.svg")} type="image/svg+xml" />
    {!isIndexable && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      /*
      There is deliberately no theme script here. The system preference is the
      single source of truth, and `color-scheme: light dark` plus `light-dark()`
      resolve it in CSS before first paint, so there is no stored preference to
      restore, no state to desynchronise, and no flash to prevent.
    */
    }
  </head>

  <body class="bg-canvas text-ink font-sans text-body min-h-dvh antialiased">
    {
      /*
      `sr-only` plus `focus:not-sr-only` is the whole skip link: no offscreen
      transform to maintain, and it stays reachable if CSS transforms fail.
    */
    }
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-2xs focus:left-2xs focus:z-100 focus:inline-flex focus:min-h-control focus:items-center focus:rounded-md focus:bg-accent focus:px-sm focus:text-control focus:text-on-accent focus:no-underline"
      href="#main"
    >
      Skip to content
    </a>

    {chrome === "site" && <SiteHeader />}

    {
      /*
      The frame lives here, not in the pages. A page renders sections and has
      no way to state a width, so the column cannot differ between one page and
      the next, which it previously did, by 26rem.

      `outline-none` because this is a programmatic focus target for the skip
      link, not something the reader tabbed to.
    */
    }
    {/* The gap above the footer belongs to this layout, which owns both. */}
    <main
      class="mx-auto mb-section w-full max-w-frame px-md outline-none md:px-lg"
      id="main"
      tabindex="-1"
    >
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
