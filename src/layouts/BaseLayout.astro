---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site.ts";
import { orThrow } from "../prelude/adt.ts";
import { activeTarget, canonicalHref, indexable } from "../lib/deployment.ts";
import { siteDescription } from "../lib/identity.ts";
import { bcp47Of, SITE_LANG } from "../lib/lang.ts";
import { speculation } from "../config/speculation.ts";
import { prefetchRules, serialise } from "../lib/speculation.ts";
import { assetUrl, currentBase, joinRoute } from "../lib/url.ts";
import type { RootedPath } from "../schema.ts";
import type { Chrome } from "./chrome.ts";

/** Hreflang route shape used by the layout. */
type Alternate = {
  readonly hrefLang: string;
  readonly route: RootedPath;
};

/* Explicit `undefined` preserves optional forwarding under `exactOptionalPropertyTypes`. */
type Props = {
  readonly title?: string | undefined;
  readonly description?: string | undefined;
  /** Set on article pages so the OG type is accurate. */
  readonly type?: "website" | "article" | undefined;
  readonly chrome?: Chrome | undefined;
  /** BCP 47 tag for page content when it differs from site language. */
  readonly lang?: string | undefined;
  /** Canonical route when this page is an alternate rendition. */
  readonly canonicalRoute?: RootedPath | undefined;
  /** Language alternates of this page, empty where it has none. */
  readonly alternates?: readonly Alternate[] | undefined;
};

const {
  title,
  description = siteDescription,
  type = "website",
  chrome = "site",
  lang = bcp47Of(SITE_LANG),
  canonicalRoute,
  alternates = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;

/* Resolve deployment once; unknown targets fail the build. */
const target = orThrow(activeTarget(Astro.site), "deployment");

/* Canonical URL names canonical deployment; `canonicalRoute` handles alternates. */
const deployed = (route: RootedPath): string => joinRoute(target.base, route);

const canonical = orThrow(
  canonicalHref(
    target,
    canonicalRoute === undefined ? Astro.url.pathname : deployed(canonicalRoute),
  ),
  "canonical URL",
);

/* Alternate links target canonical deployment from every mirror. */
const alternateLinks = alternates.map(({ hrefLang, route }) => ({
  hrefLang,
  href: orThrow(canonicalHref(target, deployed(route)), `alternate ${hrefLang}`),
}));

/* Only canonical copy is indexable; based mirrors also receive `noindex`. */
const isIndexable = indexable(target.role);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternateLinks.map(({ hrefLang, href }) => (
        <link rel="alternate" hreflang={hrefLang} href={href} />
      ))
    }
    <link rel="sitemap" type="application/xml" href={assetUrl("/sitemap-index.xml")} />
    {/* ICO size prevents Chrome preferring raster over theme-aware SVG. */}
    <link rel="icon" href={assetUrl("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={assetUrl("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={assetUrl("/apple-touch-icon.png")} />

    {
      /*
       * Prefetch on hover. A data block, not a script: the engine parses the
       * JSON and no JavaScript runs, so the zero-client-JS contract holds and
       * an engine without the feature simply ignores the element.
       */
    }
    <script
      type="speculationrules"
      is:inline
      set:html={serialise(prefetchRules(currentBase(), speculation.eagerness))}
    />
    {!isIndexable && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="bg-canvas text-ink font-sans text-body min-h-dvh antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-2xs focus:left-2xs focus:z-100 focus:inline-flex focus:min-h-control focus:items-center focus:rounded-md focus:bg-accent focus:px-sm focus:text-control focus:text-on-accent focus:no-underline"
      href="#main"
    >
      Skip to content
    </a>

    {chrome === "site" && <SiteHeader />}

    <main
      class="mx-auto mb-section w-full max-w-frame px-md outline-none md:px-lg"
      id="main"
      tabindex="-1"
    >
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
