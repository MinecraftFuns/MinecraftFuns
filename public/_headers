# Cloudflare Pages response headers.
#
# Inert on GitHub Pages, which serves files without consulting this. It is kept
# because the extensionless routes below are exactly the ones a host guesses
# wrong: a static build is only files, so the Content-Type set in an Astro
# endpoint's Response applies in dev and is gone by the time the artifact ships.
#
# Pruned against the legacy file rather than copied. Dropped: preconnect and
# prefetch hints to a CDN this site no longer contacts, and an x-declaration
# header pointing at a page that no longer exists.

/pgp
  content-type: application/pgp-keys; charset=utf-8
  content-disposition: attachment; filename=joefang.asc

# The specification requires the binary key and suggests this type.
/.well-known/openpgpkey/hu/*
  content-type: application/octet-stream

/.well-known/openpgpkey/policy
  content-type: text/plain; charset=utf-8

/.well-known/matrix/*
  content-type: application/json
  access-control-allow-origin: *

/404.html
  x-robots-tag: noindex
