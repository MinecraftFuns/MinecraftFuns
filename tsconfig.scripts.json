{
  // The build and gate scripts, which `astro check` never sees: it reads the
  // main tsconfig, and that excludes this tree so the two projects cannot both
  // claim a file.
  //
  // These were `.mjs` under `checkJs` with `noImplicitAny` off, which was the
  // honest choice at the time: switching it on reported 202 unannotated
  // parameters to surface 32 real problems, and the answer would have been 202
  // JSDoc comments restating what every call site already says.
  //
  // Renaming them to `.ts` dissolves that trade rather than settling it.
  // Inference supplies all 202 for free, `strictest` applies in full, and Node
  // 24 runs the files directly, so nothing is compiled and no build step
  // appears between editing a gate and running it.
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    // These files are *executed* by Node's type stripper, which erases
    // annotations and refuses anything that would need code generated for it.
    // `enum`, `namespace`, and parameter properties therefore fail at runtime
    // rather than at the typecheck. This makes that a checked property.
    "erasableSyntaxOnly": true,
    // ES2024 for `Object.groupBy`; DOM because the audit probes are functions
    // serialised into a browser page.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // `astro/client` because the config imports `lib/sitemap.ts`, and the
    // module graph reaches `import.meta.env` from there.
    "types": ["node", "astro/client"]
  },
  "include": ["scripts/**/*.ts", "astro.config.ts"]
}
